# EmailJS
REACT_APP_EMAIL_CODE=

# Supabase（予約ブロック日の保存先）
# Supabase ダッシュボード → Project Settings → API から取得
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# 管理画面のユーザー名に付けるドメイン
# 例：ユーザー名「admin」→ Supabase 上のメールアドレス「admin@seta-tei.local」
REACT_APP_ADMIN_EMAIL_DOMAIN=seta-tei.local
